# Required: use a long, random value (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Required: set a strong admin password before starting the server.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional. Defaults to http://localhost:3000. Set this to your public HTTPS URL in production.
BASE_URL=http://localhost:3000
PORT=3000
